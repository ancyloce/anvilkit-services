# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Outputs
outputs/

# Generated local Compose credentials and configuration
/.local/compose/
/.local/dev/

# Documentation is local-only (owner decision 2026-10-19): docs/ is never committed;
# tools/check-docs.py and tools/check-source-export.py treat its absence in a clone as
# UNEXECUTED, not as a failure.
/docs/

# Logs
logs/

# Contract sources and generated bindings live in the contracts submodule (contracts/, its own
# repository); tools/generate-contracts.py --check fails on drift there and in Control's sqlc output.

# Pinned Python verification environment created by tools/verification-env.sh
/.local/verification-venv/

# Every other machine-local state under .local/: verified source snapshots (.local/baseline/),
# the preserved legacy API worktree (.local/legacy/) and local tool binaries (.local/bin/)
/.local/

# Python byte-code, editable-install metadata and pytest cache of the verification tools
__pycache__/
*.egg-info/
.pytest_cache/

# Binaries `go build` leaves in the parent's test modules (the load tool, the
# MCP fixture built from tests/integration/cmd/mcpfixture)
/tests/load/load
/tests/integration/mcpfixture
