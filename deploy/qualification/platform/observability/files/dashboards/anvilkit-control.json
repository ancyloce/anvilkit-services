{
  "uid": "anvilkit-control",
  "title": "AnvilKit Control",
  "tags": [
    "anvilkit"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "utc",
  "panels": [
    {
      "id": 0,
      "type": "timeseries",
      "title": "RPCs by code",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (rate(anvilkit_control_rpcs_total[5m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPC p95 by method",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "anvilkit:control_rpc_duration_seconds:p95_5m",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "gRPC capacity pools: held / bound",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool) (anvilkit_control_grpc_pool_in_use)",
          "legendFormat": "{{pool}} held"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pool) (anvilkit_control_grpc_pool_limit)",
          "legendFormat": "{{pool}} bound"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CAPACITY_EXHAUSTED refusals",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool) (rate(anvilkit_control_capacity_refusals_total[5m]))",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Database pool",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(anvilkit_control_db_pool_acquired_connections)",
          "legendFormat": "acquired"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(anvilkit_control_db_pool_max_connections)",
          "legendFormat": "bound"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(anvilkit_control_db_pool_empty_acquires_total[5m]))",
          "legendFormat": "waits/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Relay backlog by lane",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (lane) (anvilkit_control_relay_backlog)",
          "legendFormat": "{{lane}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Unresolved obligations",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (class, state) (anvilkit_control_unresolved_obligations)",
          "legendFormat": "{{class}} {{state}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Unresolved obligations: oldest",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (class, state) (anvilkit_control_unresolved_obligation_oldest_seconds)",
          "legendFormat": "{{class}} {{state}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox: oldest unforwarded",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(anvilkit_control_outbox_oldest_unforwarded_seconds)",
          "legendFormat": "oldest"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Outbox forwarded / failed",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(anvilkit_control_outbox_forwarded_total[5m]))",
          "legendFormat": "forwarded"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(anvilkit_control_outbox_forward_failures_total[5m]))",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "First progress p50 / p95 (acceptance to leaving accepted; SLO row 2)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "anvilkit:operation_first_progress_seconds:p50_1h",
          "legendFormat": "p50 {{kind}} {{profile}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "anvilkit:operation_first_progress_seconds:p95_1h",
          "legendFormat": "p95 {{kind}} {{profile}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Completion p50 / p95 to succeeded (a Generation's accepted candidate; SLO row 2)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "anvilkit:operation_completion_seconds:p50_1h{lifecycle=\"succeeded\"}",
          "legendFormat": "p50 {{kind}} {{profile}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "anvilkit:operation_completion_seconds:p95_1h{lifecycle=\"succeeded\"}",
          "legendFormat": "p95 {{kind}} {{profile}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "First progress and completions per hour by lifecycle reached",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind, lifecycle) (increase(anvilkit_control_operation_first_progress_seconds_count[1h]))",
          "legendFormat": "first progress {{kind}} {{lifecycle}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind, lifecycle) (increase(anvilkit_control_operation_completion_seconds_count[1h]))",
          "legendFormat": "completed {{kind}} {{lifecycle}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Authorization decision age at use p50 / p95 (production authority source; SLO row 3)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "anvilkit:authority_decision_age_seconds:p50_5m",
          "legendFormat": "p50 {{kind}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "anvilkit:authority_decision_age_seconds:p95_5m",
          "legendFormat": "p95 {{kind}}"
        }
      ]
    }
  ]
}
